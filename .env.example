# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Protects /api/cron/* routes (GitHub Actions sends this header)
CRON_SECRET=generate-a-long-random-string

# Warframe.market API - descriptive User-Agent (project name + contact)
WFM_USER_AGENT=warframe-market-stocks/0.1 (your-contact@example.com)

# Scan thresholds/batching (all optional — defaults shown)
# SCAN_BATCH_SIZE=20
# MIN_SPREAD=5
# MIN_ROI_PCT=15
# PRICE_DROP_FACTOR=0.85
# SCAN_STATS_EVERY_BATCH=true

# Discord webhook for alert delivery (optional until Discord phase)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-webhook-token
